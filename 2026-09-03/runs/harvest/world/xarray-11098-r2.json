 "patch": "diff --git a/xarray/core/indexes.py b/xarray/core/indexes.py\nindex 74729d8e..8e2f9894 100644\n--- a/xarray/core/indexes.py\n+++ b/xarray/core/indexes.py\n@@ -26,6 +26,7 @@ from xarray.core.utils import (\n     is_allowed_extension_array_dtype,\n     is_dict_like,\n     is_scalar,\n+    is_valid_numpy_dtype,\n )\n \n if TYPE_CHECKING:\n@@ -675,6 +676,16 @@ class PandasIndex(Index):\n                 coord_dtype = index.dtype\n             else:\n                 coord_dtype = get_valid_numpy_dtype(index)\n+        elif not (\n+            is_allowed_extension_array_dtype(coord_dtype)\n+            or is_valid_numpy_dtype(coord_dtype)\n+        ):\n+            # coord_dtype can be provided by a pandas.Index. Pandas 3.0 stores\n+            # strings by default in a StringDtype extension dtype, which xarray\n+            # deliberately does not support (see\n+            # xarray.core.utils.is_allowed_extension_array_dtype), so fall back\n+            # to a numpy-compatible dtype inferred from the index.\n+            coord_dtype = get_valid_numpy_dtype(index)\n         self.coord_dtype = coord_dtype\n \n     def _replace(self, index, dim=None, coord_dtype=None):\n",

+    def __init__(self, first: Any = 9, /, second: Any = 2) -> None:
+        super().__init__(first, second)
+
+
+class SpamSamePosonlyDefault(EggWithDefaults):
+    def __init__(self, first: Any = 1, /, second: Any = 2) -> None:  # [useless-parent-delegation]
+        super().__init__(first, second)

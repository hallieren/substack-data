+
+
+class EggWithDefaults:
+    def __init__(self, first: Any = 1, /, second: Any = 2) -> None:
+        pass
+
+
+class HamChangedPosonlyDefault(EggWithDefaults):
+    # Not useless: the positional-only ``first`` has a different default from the
